{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ForecastEdge official NFL four-model card (research-only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cardId",
    "season",
    "week",
    "status",
    "cutoffAt",
    "frozenAt",
    "publishedAt",
    "publisherId",
    "inputManifestHash",
    "cardHash",
    "games"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "cardId": {
      "type": "string",
      "minLength": 1
    },
    "season": {
      "type": "integer",
      "minimum": 2020
    },
    "week": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18
    },
    "status": {
      "enum": [
        "FROZEN_ON_TIME",
        "FROZEN_LATE"
      ]
    },
    "cutoffAt": {
      "type": "string",
      "format": "date-time"
    },
    "frozenAt": {
      "type": "string",
      "format": "date-time"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "publisherId": {
      "const": "nfl-official-wednesday"
    },
    "inputManifestHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cardHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "games": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/game"
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "capturedAt",
        "sha256"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moneylineWinner",
        "spreadPick",
        "spreadLine",
        "totalPick",
        "totalLine",
        "projectedHomeScore",
        "projectedAwayScore",
        "confidence",
        "wagerStatus",
        "marketEvidence",
        "modelEvidence"
      ],
      "properties": {
        "moneylineWinner": {
          "type": "string",
          "minLength": 1
        },
        "spreadPick": {
          "type": "string",
          "minLength": 1
        },
        "spreadLine": {
          "type": "number"
        },
        "totalPick": {
          "enum": [
            "OVER",
            "UNDER"
          ]
        },
        "totalLine": {
          "type": "number"
        },
        "projectedHomeScore": {
          "type": "number",
          "minimum": 0
        },
        "projectedAwayScore": {
          "type": "number",
          "minimum": 0
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "wagerStatus": {
          "const": "NO BET"
        },
        "marketEvidence": {
          "$ref": "#/$defs/evidence"
        },
        "modelEvidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gameId",
        "kickoffAt",
        "homeTeam",
        "awayTeam",
        "qbEvidence",
        "models"
      ],
      "properties": {
        "gameId": {
          "type": "string",
          "minLength": 1
        },
        "kickoffAt": {
          "type": "string",
          "format": "date-time"
        },
        "homeTeam": {
          "type": "string",
          "minLength": 1
        },
        "awayTeam": {
          "type": "string",
          "minLength": 1
        },
        "qbEvidence": {
          "$ref": "#/$defs/evidence"
        },
        "models": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "A",
            "B",
            "C",
            "C-QB"
          ],
          "properties": {
            "A": {
              "$ref": "#/$defs/model"
            },
            "B": {
              "$ref": "#/$defs/model"
            },
            "C": {
              "$ref": "#/$defs/model"
            },
            "C-QB": {
              "$ref": "#/$defs/model"
            }
          }
        }
      }
    }
  }
}
